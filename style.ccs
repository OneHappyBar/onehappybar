/* ===== One Happy Bar — GitHub Pages ===== */
:root {
  --sand: #f7e7ce;
  --sun: #ffc857;
  --coral: #ff6b6b;
  --ocean: #0077b6;
  --ocean-deep: #023e8a;
  --aqua: #48cae4;
  --foam: rgba(255, 255, 255, 0.22);
  --glass: rgba(255, 255, 255, 0.14);
  --glass-border: rgba(255, 255, 255, 0.35);
  --text: #ffffff;
  --text-soft: rgba(255, 255, 255, 0.88);
  --text-muted: rgba(255, 255, 255, 0.7);
  --shadow: 0 25px 50px -12px rgba(2, 40, 70, 0.55);
  --radius: 24px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
  --font: "Poppins", system-ui, sans-serif;
  --display: "Playfair Display", Georgia, serif;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  -webkit-text-size-adjust: 100%;
}

body {
  min-height: 100dvh;
  font-family: var(--font);
  color: var(--text);
  background-color: #024e6c;
  background-image:
    linear-gradient(
      165deg,
      rgba(2, 62, 138, 0.35) 0%,
      rgba(0, 119, 182, 0.25) 40%,
      rgba(255, 159, 67, 0.2) 100%
    ),
    url("[images.unsplash.com](https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1920&q=80)");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
  line-height: 1.5;
  overflow-x: hidden;
}

.bg-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(255, 200, 87, 0.25), transparent 55%),
    radial-gradient(ellipse 60% 40% at 100% 100%, rgba(0, 180, 216, 0.2), transparent 50%),
    linear-gradient(to bottom, rgba(1, 40, 70, 0.25), rgba(1, 30, 55, 0.55));
  z-index: 0;
}

.page {
  position: relative;
  z-index: 1;
  min-height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.25rem;
}

/* ----- Glass card ----- */
.glass-card {
  width: 100%;
  max-width: 440px;
  padding: 1.75rem 1.35rem 1.25rem;
  border-radius: var(--radius);
  background: var(--glass);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(22px) saturate(1.35);
  -webkit-backdrop-filter: blur(22px) saturate(1.35);
  animation: cardIn 0.85s var(--ease) both;
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(28px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ----- Brand / logo ----- */
.brand {
  text-align: center;
}

.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.65rem;
}

.logo-mark {
  width: 72px;
  height: 72px;
  filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.25));
  animation: floatLogo 4s ease-in-out infinite;
}

@keyframes floatLogo {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6px);
  }
}

.logo-eyebrow {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--sun);
  margin-bottom: 0.15rem;
}

.logo-name {
  font-family: var(--display);
  font-size: clamp(1.75rem, 6vw, 2.15rem);
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.15;
  background: linear-gradient(120deg, #fff 0%, #ffe8a3 45%, #fff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: none;
}

.tagline {
  margin-top: 0.65rem;
  font-size: 0.8rem;
  color: var(--text-muted);
  font-weight: 400;
}

.divider {
  height: 1px;
  margin: 1.25rem 0 1.15rem;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.45),
    transparent
  );
}

/* ----- Content ----- */
.section-title {
  font-size: 1.15rem;
  font-weight: 600;
  text-align: center;
  margin-bottom: 0.35rem;
}

.intro {
  text-align: center;
  font-size: 0.875rem;
  color: var(--text-soft);
  margin-bottom: 1.15rem;
}

.policies {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.35rem;
}

.policy {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.85rem 0.95rem;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 0.9rem;
  color: var(--text-soft);
  animation: fadeUp 0.6s var(--ease) both;
}

.policy:nth-child(1) {
  animation-delay: 0.15s;
}
.policy:nth-child(2) {
  animation-delay: 0.28s;
}
.policy:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.policy strong {
  color: var(--text);
  font-weight: 600;
}

.policy-icon {
  flex-shrink: 0;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: rgba(72, 202, 228, 0.2);
  color: var(--aqua);
}

/* ----- Checkbox ----- */
.checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  cursor: pointer;
  user-select: none;
  margin-bottom: 1.25rem;
  padding: 0.25rem 0.15rem;
}

.checkbox-row input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.custom-check {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  margin-top: 1px;
  border-radius: 7px;
  border: 2px solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.08);
  transition: border-color 0.25s var(--ease), background 0.25s var(--ease),
    box-shadow 0.25s var(--ease), transform 0.2s var(--ease);
  position: relative;
}

.custom-check::after {
  content: "";
  position: absolute;
  left: 6px;
  top: 2px;
  width: 6px;
  height: 12px;
  border: solid #023e8a;
  border-width: 0 2.5px 2.5px 0;
  transform: scale(0) rotate(45deg);
  transition: transform 0.2s var(--ease);
}

.checkbox-row input:checked + .custom-check {
  background: linear-gradient(145deg, var(--sun), #ff9f43);
  border-color: transparent;
  box-shadow: 0 0 0 3px rgba(255, 200, 87, 0.35);
}

.checkbox-row input:checked + .custom-check::after {
  transform: scale(1) rotate(45deg);
}

.checkbox-row input:focus-visible + .custom-check {
  box-shadow: 0 0 0 3px rgba(72, 202, 228, 0.55);
}

.checkbox-row:active .custom-check {
  transform: scale(0.94);
}

.checkbox-label {
  font-size: 0.9rem;
  color: var(--text-soft);
  line-height: 1.4;
}

/* ----- Button ----- */
.btn-continue {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.95rem 1.25rem;
  border: none;
  border-radius: 14px;
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--ocean-deep);
  background: linear-gradient(135deg, #ffe566 0%, #ffc857 40%, #ff9f43 100%);
  box-shadow: 0 10px 28px rgba(255, 159, 67, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.5);
  cursor: pointer;
  transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease),
    opacity 0.3s var(--ease), filter 0.25s var(--ease);
}

.btn-continue:disabled {
  opacity: 0.42;
  cursor: not-allowed;
  filter: grayscale(0.35);
  box-shadow: none;
  transform: none;
}

.btn-continue:not(:disabled):hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(255, 159, 67, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.55);
}

.btn-continue:not(:disabled):active {
  transform: translateY(0) scale(0.98);
}

.btn-continue svg {
  transition: transform 0.25s var(--ease);
}

.btn-continue:not(:disabled):hover svg {
  transform: translateX(3px);
}

.card-footer {
  margin-top: 1.15rem;
  text-align: center;
}

.card-footer p {
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
}

/* ----- Larger screens ----- */
@media (min-width: 480px) {
  .glass-card {
    padding: 2.15rem 2rem 1.5rem;
  }

  .logo-mark {
    width: 84px;
    height: 84px;
  }

  .policy {
    font-size: 0.95rem;
  }
}

@media (min-width: 768px) {
  .page {
    padding: 2rem;
  }

  .glass-card {
    max-width: 460px;
  }
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
